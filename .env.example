POSTGRES_USER=fileforge
POSTGRES_PASSWORD=fileforge
POSTGRES_DB=fileforge
DATABASE_URL=postgres://fileforge:fileforge@localhost:5433/fileforge?sslmode=disable
API_PORT=8080
JWT_SECRET=change-me-in-production
REDIS_URL=redis://localhost:6379

# Phase 5 hardening. All optional — these are the defaults if unset.
# RATE_LIMIT_PER_MINUTE: requests per minute, per user (or per IP when
#   unauthenticated, which is where credential stuffing shows up).
# MAX_CONCURRENT_JOBS: how much work one user can have in flight at once;
#   a batch claims one slot per file.
# RETENTION_DAYS: how long files live before `cmd/cleanup` removes them.
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_JOBS=20
RETENTION_DAYS=7

# AI features (Phase 7). ocr and document-insights need nothing here - they
# run entirely locally via Tesseract/poppler. Only ai-analyze (document
# summarize/classify) needs a key, and it's free: get one with no credit
# card at https://aistudio.google.com/apikey. Left empty, ai-analyze fails
# per-request with a clear "not configured" error; nothing else is affected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Which Docker Hub account the 6 service images are named under. Local dev
# doesn't need this set - `docker compose build` tags images locally as
# fileforge/fileforge-<service>:latest regardless. It matters once CI is
# pushing to Docker Hub and a deploy pulls those images instead of building.
DOCKERHUB_USERNAME=
